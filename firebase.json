{
  "functions": [
    {
      "source": "functions",
      "codebase": "mcp",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": ["node_modules", ".git", "test", "scripts", "lint", "*.local"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/node_modules/**",
      "**/.DS_Store",
      "**/.git/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "mcp",
          "region": "us-central1",
          "pinTag": false
        }
      },
      {
        "source": "/mcp/server-card",
        "destination": "/.well-known/mcp/server-card.json"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Link",
            "value": "</sitemap-index.xml>; rel=\"sitemap\"; type=\"application/xml\", </llms.txt>; rel=\"alternate\"; type=\"text/plain\"; title=\"llms.txt\", </.well-known/ard.json>; rel=\"ard\"; type=\"application/json\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/mcp-server-card+json\", </agents.md>; rel=\"help\"; type=\"text/markdown\""
          }
        ]
      },
      {
        "source": "**/*.md",
        "headers": [
          { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "**/*.jsonl",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/jsonl; charset=utf-8"
          },
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "/.well-known/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" },
          { "key": "Access-Control-Allow-Origin", "value": "*" }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
      },
      {
        "source": "/mcp",
        "headers": [
          { "key": "Cache-Control", "value": "no-store" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      },
      {
        "source": "/*.@(png|ico|txt|xml|json)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "/_astro/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/speaker-kit",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      },
      {
        "source": "/speaker-kit/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
      }
    ]
  }
}
