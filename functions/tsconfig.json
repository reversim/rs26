{
  // The default config deliberately covers every .ts file in this package — src, test
  // and scripts. Tooling that resolves a tsconfig by walking up from a file (Vite/oxc,
  // tsx) must land here and never on the site's root tsconfig.json, which extends
  // `astro/tsconfigs/strict` and so cannot load without the root node_modules that this
  // package's CI jobs never install. Emit settings live in tsconfig.build.json.
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src", "test", "scripts"],
  "exclude": ["lib", "node_modules"]
}
