---
import Layout from "../../layouts/Layout.astro";
import { coc } from "../../config/coc";
---

<Layout>
  <h2>{coc.title}</h2>
  <p>{coc.intro}</p>

  {
    coc.sections.map((section) => (
      <div class="card">
        <h4>{section.heading}</h4>
        <p>{section.body}</p>
      </div>
    ))
  }

  <p class="source">
    Source: <a href={coc.source} target="_blank" rel="noopener">{coc.source}</a>
  </p>
</Layout>

<style lang="scss">
  h2 {
    color: var(--rs26-white);
    margin-top: 24px;
  }

  h4,
  p {
    margin: 0;
  }

  p {
    line-height: 1.6;
    color: var(--rs26-text);
  }

  h4 {
    font-weight: 600;
    color: var(--rs26-white);
  }

  .card {
    margin-top: 30px;
    padding: 24px;
    border-radius: var(--rs26-r-md);
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);

    h4 {
      font-size: 20px;
    }

    p {
      margin-top: 6px;
    }
  }

  .source {
    margin-top: 24px;
    font-size: 14px;
  }
</style>
