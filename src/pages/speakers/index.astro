---
import Layout from "../../layouts/Layout.astro";
import { getSpeakers } from "../../helpers/data/getSpeakers";
import MemberGrid from "../../components/memberGrid.astro";
import FilterTabs from "../../components/filterTabs.astro";
import PageHeader from "../../components/pageHeader.astro";
import type { TeamMember } from "../../types/team";
import { event } from "../../config/event";

const speakers = await getSpeakers();

const speakerCards: TeamMember[] = speakers.map((speaker) => ({
  id: speaker.id.toString(),
  slug: speaker.slug ?? "",
  name: speaker.fullName || "",
  title: speaker.tagLine || "",
  company: "",
  picture: speaker.profilePicture ?? "",
  bio: speaker.bio || "",
  day: speaker.day,
}));
---

<Layout havePaddingBottom={true}>
  <PageHeader
    eyebrow="Who's speaking"
    title="Our Speakers"
    description="We are thrilled to unveil our distinguished speaker lineup for the upcoming Reversim Summit 2026. These accomplished individuals will delve into a diverse array of technology topics during the conference. Get ready for an engaging exploration of the latest trends and insights across the tech landscape!"
  />
  <FilterTabs
    id="speakers-day-filter"
    attr="day"
    targetSelector=".member"
    sticky={true}
    options={event.days.options}
  />
  <MemberGrid members={speakerCards} pageBase="speaker" />
</Layout>

