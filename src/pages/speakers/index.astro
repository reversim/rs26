---
import Layout from "../../layouts/Layout.astro";
import { getSpeakers } from "../../helpers/data/getSpeakers";
import MemberGrid from "../../components/memberGrid.astro";
import type { TeamMember } from "../../types/team";

const speakers = await getSpeakers();

const speakerCards: TeamMember[] = speakers.map((speaker) => ({
  id: speaker.id.toString(),
  slug: speaker.slug ?? "",
  name: speaker.fullName || "",
  title: speaker.tagLine || "",
  company: "",
  picture: speaker.profilePicture ?? "",
  bio: speaker.bio || "",
}));
---

<Layout havePaddingBottom={true}>
  <h2>Our Speakers</h2>
  <p class="description">
    We are thrilled to unveil our distinguished speaker lineup for the upcoming
    Reversim Summit 2026. These accomplished individuals will delve into a
    diverse array of technology topics during the conference. Get ready for an
    engaging exploration of the latest trends and insights across the tech
    landscape!
  </p>
  <MemberGrid members={speakerCards} pageBase="speaker" />
</Layout>

<style lang="scss">
  .description {
    margin-bottom: 20px;
    font-weight: 300;
  }
</style>
