---
import MemberGrid from "../../components/memberGrid.astro";
import PageHeader from "../../components/pageHeader.astro";
import { getTeamMembers } from "../../helpers/data/getTeam";
import Layout from "../../layouts/Layout.astro";

const teamMembers = await getTeamMembers();
---

<Layout havePaddingBottom={true}>
  <PageHeader
    eyebrow="The people behind it"
    title="Our team"
    description="Reversim Summit 2026 is a testament to community collaboration, driven by a dedicated team of passionate volunteers who are experts in their respective fields. Our content committee, comprised of enthusiastic individuals, works tirelessly to curate an enriching and insightful experience for all attendees."
  />

  <MemberGrid members={teamMembers} />
</Layout>
