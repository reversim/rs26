---
import MemberGrid from "../../components/member/memberGrid.astro";
import PageTitle from "../../components/shared/pageTitle.astro";
import { getTeamMembers } from "../../helpers/data/getTeam";
import Layout from "../../layouts/Layout.astro";
import { ORGANIZATION } from "../../helpers/agents/schema";

const teamMembers = await getTeamMembers();

// The page that says who we are carries the Organization entity, with the
// volunteers as its members.
const schema = {
  ...ORGANIZATION,
  member: teamMembers.map((teamMember) => ({
    "@type": "Person",
    name: teamMember.name,
    jobTitle: teamMember.role || teamMember.title,
    url: `https://summit2026.reversim.com/about/${teamMember.slug}`,
  })),
};
---

<Layout havePaddingBottom={true} schema={schema}>
  <PageTitle
    eyebrow="The people behind it"
    title="Our team"
    description="Reversim Summit 2026 is a testament to community collaboration, driven by a dedicated team of passionate volunteers who are experts in their respective fields. Our content committee, comprised of enthusiastic individuals, works tirelessly to curate an enriching and insightful experience for all attendees."
  />

  <MemberGrid members={teamMembers} />
</Layout>
