---
import Layout from "../../layouts/Layout.astro";
import { getSessions } from "../../helpers/data/getSessions";
import slug from "slug";

const sessions = await getSessions();
const sessionsList = sessions.rawSessionsList;

function getTalkInfo(fullText: string): {
  shouldLoadMore: boolean;
  text: string;
  shouldDisplay: boolean;
} {
  const maxLength = 150;

  if (!fullText) {
    return { shouldDisplay: false, shouldLoadMore: false, text: "" };
  }

  if (fullText?.length <= maxLength) {
    return { shouldLoadMore: false, text: fullText, shouldDisplay: true };
  }
  const truncatedText = fullText?.slice(0, maxLength) + "...";
  return { text: truncatedText, shouldLoadMore: true, shouldDisplay: true };
}
---

<Layout>
  <h2 class="page-title">Our Sessions</h2>

  <div class="sessions-container">
    {
      sessionsList.map((session) => {
        const descriptionInfo = getTalkInfo(session.description);
        if (descriptionInfo.shouldDisplay) {
          return (
            <div class="card">
              {!session.isPlenumSession ? (
                <a
                  href={`/session/${slug(session.title)}`}
                  class="session-link"
                >
                  <h4>{session.title}</h4>
                </a>
              ) : (
                <h4>{session.title}</h4>
              )}
              <p class="session-description">
                {descriptionInfo.text}
                {descriptionInfo.shouldLoadMore && (
                  <a
                    href={`/session/${slug(session.title)}`}
                    class="session-link read-more"
                  >
                    Read More
                  </a>
                )}
              </p>
            </div>
          );
        }
      })
    }
  </div>
</Layout>

<style lang="scss">
  .page-title {
    color: var(--rs26-white);
    margin-top: 24px;
  }

  .card {
    padding: 20px;
    margin-top: 24px;
    border-radius: var(--rs26-r-md);
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
    transition:
      transform 0.2s var(--rs26-ease),
      border-color 0.2s var(--rs26-ease);

    &:hover {
      transform: translateY(-2px);
      border-color: var(--rs26-blue);
    }

    h4 {
      font-family: var(--rs26-display);
      font-size: 18px;
      color: var(--rs26-white);
    }

    .session-description {
      margin-top: 8px;
      font-size: 14px;
      color: var(--rs26-text);

      .read-more {
        color: var(--rs26-blue-bright);
        margin-left: 5px;
        font-size: 0.9em;
        cursor: pointer;

        &:hover {
          text-decoration: underline;
        }
      }
    }
  }
</style>
