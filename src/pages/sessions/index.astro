---
import Layout from "../../layouts/Layout.astro";
import { getSessions } from "../../helpers/data/getSessions";
import { getSpeakers } from "../../helpers/data/getSpeakers";
import FilterTabs from "../../components/filterTabs.astro";
import SessionCard from "../../components/sessions/sessionCard.astro";
import type { AgendaSpeaker } from "../../types/agenda";
import slug from "slug";

const [sessions, speakers] = await Promise.all([getSessions(), getSpeakers()]);
const speakersMap = new Map(speakers.map((speaker) => [String(speaker.id), speaker]));

const sessionsList = sessions.rawSessionsList.filter((session) => session.description);
---

<Layout>
  <h2 class="page-title">Our Sessions</h2>

  <FilterTabs
    id="sessions-day-filter"
    attr="day"
    targetSelector=".session-card"
    sticky={true}
    options={[
      { value: "all", label: "Both days" },
      { value: "1", label: "Day 1" },
      { value: "2", label: "Day 2" },
    ]}
  />

  <div class="sessions-container">
    {
      sessionsList.map((session) => {
        const resolvedSpeakers = session.speakers
          .map((speaker) => speakersMap.get(speaker.id))
          .filter((speaker): speaker is AgendaSpeaker => speaker !== undefined);

        return (
          <SessionCard
            title={session.title}
            description={session.description}
            href={`/session/${slug(session.title)}`}
            speakers={resolvedSpeakers}
            day={session.day}
          />
        );
      })
    }
  </div>
</Layout>

<style lang="scss">
  .page-title {
    color: var(--rs26-white);
    margin-top: 24px;
  }

  .sessions-container {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
</style>
