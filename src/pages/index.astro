---
import "@splidejs/splide/css";
import { Image } from "astro:assets";
import logoWhite from "../assets/logo-white.png";
import { event } from "../config/event";
import AboutSection from "../components/aboutSection.astro";
import HeroSection from "../components/heroSection.astro";
import PastEvents from "../components/pastEventsSection.astro";
import SponsorsGrid from "../components/sponsorsGrid.astro";
import TeamMembersSection from "../components/teamMembersSection.astro";
import VenueSection from "../components/venueSection.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout havePadding={false}>
  <HeroSection />
  <AboutSection />
  <SponsorsGrid />
  <TeamMembersSection />
  <PastEvents />
  <VenueSection />

  <footer class="site-foot">
    <div class="foot-grid">
      <div class="foot-brand">
        <Image class="foot-logo" src={logoWhite} alt={event.name} height={30} />
        <p class="foot-tag">{event.name} · {event.dates}</p>
      </div>
      <nav class="foot-nav">
        <a href="https://summit.reversim.com/" target="_blank" rel="noopener">
          Past events
        </a>
        <a href="/coc">Code of conduct</a>
        <a href="/attributions">Attributions</a>
      </nav>
    </div>
  </footer>
</Layout>

<style lang="scss">
  .site-foot {
    background: var(--rs26-navy-3);
    color: #cdd6ec;
    padding: 54px 0 40px;

    .foot-grid {
      width: 100%;
      max-width: var(--rs26-maxw);
      margin-inline: auto;
      padding-inline: clamp(20px, 5vw, 56px);
      display: flex;
      justify-content: space-between;
      gap: 40px;
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .foot-brand {
      .foot-logo {
        height: 30px;
        width: auto;
        margin-bottom: 16px;
      }

      .foot-tag {
        font-family: var(--rs26-mono);
        font-size: 0.78rem;
        max-width: 30ch;
        color: var(--rs26-muted);
      }
    }

    .foot-nav {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;

      a:hover {
        color: var(--rs26-white);
      }
    }
  }
</style>
