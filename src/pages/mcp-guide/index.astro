---
import Layout from "../../layouts/Layout.astro";
import CodeSnippet from "../../components/mcp/codeSnippet.astro";
import { event } from "../../config/event";
import { MCP_ENDPOINT } from "../../config/agentResources";
import { mcpExamples, mcpTools } from "../../config/mcpTools";

// The MCP endpoint is served by the Cloud Function in `functions/`, which
// `firebase.json` rewrites onto this same domain; `config/agentResources`
// holds it because the discovery documents quote the same string.
const ENDPOINT = MCP_ENDPOINT;
const TOOLS = mcpTools;
const EXAMPLES = mcpExamples;

const JSON_CONFIG = `{
  "mcpServers": {
    "reversim": {
      "url": "${ENDPOINT}"
    }
  }
}`;
---

<Layout
  share={{
    title: "Reversim 2026 in your AI assistant",
    description:
      "Connect Claude, Cursor or any MCP client to the Reversim Summit 2026 agenda and plan your two days in conversation.",
  }}
>
  <article class="mcp">
    <header class="intro">
      <p class="eyebrow">For attendees</p>
      <h2>{event.shortName} in your AI assistant</h2>
      <p class="lede">
        Reversim Summit 2026 runs an <a
          href="https://modelcontextprotocol.io"
          target="_blank"
          rel="noopener">MCP</a
        > server — a small service that gives your AI assistant access to the conference
        agenda. Connect it once, then plan your two days in conversation: ask which
        talks fit your work, get a schedule with no clashes, and send it to your
        calendar.
      </p>
      <p class="note">
        It's free, needs no account and is read-only: it can look things up but
        never change anything. Talks are given in Hebrew; the server and its
        answers are in English.
      </p>
    </header>

    <section>
      <h3>Server address</h3>
      <p>This is all you need. Copy it:</p>
      <CodeSnippet
        code={ENDPOINT}
        label="the server address"
        variant="address"
      />
    </section>

    <section>
      <h3>Connecting</h3>

      <div class="card">
        <h4>Claude — web or desktop</h4>
        <ol>
          <li>Open <strong>Settings → Connectors</strong>.</li>
          <li>Click <strong>Add custom connector</strong>.</li>
          <li>
            Paste the address above, name it something like <em>Reversim</em>,
            and save.
          </li>
        </ol>
      </div>

      <div class="card">
        <h4>Claude Code</h4>
        <p>Run one command:</p>
        <CodeSnippet
          code={`claude mcp add --transport http reversim ${ENDPOINT}`}
          label="the Claude Code command"
        />
      </div>

      <div class="card">
        <h4>Cursor, VS Code and other clients</h4>
        <p>
          Add the server to your client's MCP configuration. Most clients accept
          this format:
        </p>
        <CodeSnippet code={JSON_CONFIG} label="the configuration" />
        <p class="hint">
          File locations and formats vary between clients, so check your
          client's MCP documentation if this doesn't work as-is. Any client that
          supports MCP over HTTP will work.
        </p>
      </div>
    </section>

    <section>
      <h3>What to ask</h3>
      <p>Once connected, just talk to your assistant as you normally would:</p>
      <ul class="examples">
        {EXAMPLES.map((example) => <li>{example}</li>)}
      </ul>
      <p class="hint">
        Your assistant picks the right tools on its own, so you never need to
        name them.
      </p>
    </section>

    <section>
      <h3>What it can do</h3>
      <dl class="tools">
        {
          TOOLS.map((tool) => (
            <div class="tool">
              <dt>{tool.name}</dt>
              <dd>{tool.what}</dd>
            </div>
          ))
        }
      </dl>
      <p class="hint">
        The server also offers the full agenda as a single document, plus a
        ready-made prompt that asks you a few quick questions and then builds
        your plan.
      </p>
    </section>

    <section>
      <h3>Good to know</h3>
      <ul class="facts">
        <li>
          <strong>The agenda is live.</strong> It comes from the same source as this
          website, so changes to talks or rooms appear within minutes.
        </li>
        <li>
          <strong>Nothing about you is stored.</strong> The server has no accounts
          and keeps no history. It only counts which tools are used and never records
          what you type.
        </li>
        <li>
          <strong>Public information only.</strong> The server can reach only what's
          already on this website: talks, speakers, rooms and times.
        </li>
        <li>
          <strong>Suggestions are just suggestions.</strong> Rankings are based on
          keyword matching, and your assistant then reads the abstracts to choose.
          Check the <a href="/agenda">agenda</a> before you settle on a plan.
        </li>
      </ul>
    </section>
  </article>
</Layout>

<style lang="scss">
  @use "../../styles/breakpoints" as *;

  .mcp {
    max-width: 760px;
    margin-inline: auto;
    padding-block: 24px 64px;
    color: var(--rs26-text);
    line-height: 1.65;
  }

  .eyebrow {
    font-family: var(--rs26-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rs26-mint);
    margin: 0 0 8px;
  }

  h2 {
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    color: var(--rs26-white);
    margin: 0;
    line-height: 1.15;
  }

  h3 {
    font-size: clamp(1.25rem, 3vw, 1.6rem);
    color: var(--rs26-white);
    margin: 0 0 12px;
  }

  h4 {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--rs26-white);
    margin: 0 0 10px;
  }

  p {
    margin: 12px 0;
  }

  a {
    color: var(--rs26-blue-bright);
    text-decoration: underline;
    text-underline-offset: 2px;

    &:hover {
      color: var(--rs26-white);
    }
  }

  .lede {
    font-size: clamp(1.02rem, 2.4vw, 1.18rem);
    margin-top: 14px;
  }

  .note,
  .hint {
    color: var(--rs26-muted);
    font-size: 0.92rem;
  }

  section {
    margin-top: 44px;
  }

  .card {
    margin-top: 18px;
    padding: 20px;
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
    border-radius: var(--rs26-r-md);

    p:first-of-type {
      margin-top: 0;
    }

    ol {
      margin: 0;
      padding-inline-start: 20px;

      li + li {
        margin-top: 6px;
      }
    }
  }

  .examples {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;

    li {
      position: relative;
      margin-top: 10px;
      padding: 12px 16px;
      background: var(--rs26-panel);
      border-inline-start: 2px solid var(--rs26-mint);
      border-radius: 0 var(--rs26-r-sm) var(--rs26-r-sm) 0;
      font-style: italic;
      color: var(--rs26-white);
    }
  }

  .tools {
    margin: 0;
    display: grid;
    gap: 2px;
    background: var(--rs26-navy-line);
    border: 1px solid var(--rs26-navy-line);
    border-radius: var(--rs26-r-md);
    overflow: hidden;
  }

  .tool {
    padding: 14px 16px;
    background: var(--rs26-panel);

    dt {
      font-family: var(--rs26-mono);
      font-size: 0.84rem;
      color: var(--rs26-mint);
    }

    dd {
      margin: 4px 0 0;
      font-size: 0.95rem;
    }
  }

  .facts {
    margin: 12px 0 0;
    padding-inline-start: 20px;

    li + li {
      margin-top: 10px;
    }

    strong {
      color: var(--rs26-white);
    }
  }

  .outro {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--rs26-navy-line);
    font-size: 0.95rem;
  }

  // Wide enough for the name and its description to sit side by side.
  @media (min-width: $breakpoint-medium) {
    .tool {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 16px;
      align-items: baseline;
    }
  }
</style>
