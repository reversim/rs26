---
import type { GetStaticPaths } from "astro";
import { getImage } from "astro:assets";
import MemberPage from "../../components/memberPage.astro";
import { getSpeakers } from "../../helpers/data/getSpeakers";
import { supportedSocials } from "../../config/socials";
import Layout from "../../layouts/Layout.astro";
import slugify from "slug";

export const getStaticPaths = (async () => {
  const speakers = await getSpeakers();

  return speakers.map((speaker) => ({
    params: {
      speaker: speaker.slug,
    },
    props: { ...speaker },
  }));
}) satisfies GetStaticPaths;

const {
  firstName,
  fullName,
  id,
  isTopSpeaker,
  lastName,
  profilePicture,
  slug,
  tagLine,
  bio,
  links,
  sessions,
} = Astro.props;

const socialLinks: Record<string, string> = {};

(links || []).map((link) => {
  let finalLink = link.linkType.toLowerCase();

  if (finalLink === "blog") {
    finalLink = link.url.includes("medium")
      ? supportedSocials.medium
      : supportedSocials.website;
  }

  socialLinks[finalLink] = link.url;
});

const image = await getImage({
  src: profilePicture || "",
  height: 500,
  width: 500,
});
---

<Layout havePaddingBottom={true}>
  <MemberPage
    type="speaker"
    socialList={socialLinks}
    name={fullName}
    picture={image.src}
    title={tagLine}
    bio={bio}
  />

  <div class="talks-container">
    <h3 class="talks-title">Talks</h3>

    {
      (sessions || []).map((talk) => {
        return (
          <a href={`/session/${slugify(talk.name)}`} class="talk-name">
            {talk.name}
          </a>
        );
      })
    }
  </div>
</Layout>

<style lang="scss">
  .talks-container {
    margin-top: 60px;

    .talks-title {
      font-family: var(--rs26-mono);
      font-size: 0.74rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--rs26-mint);
      margin-bottom: 12px;
    }

    .talk-name {
      display: block;
      padding-top: 8px;
      color: var(--rs26-text);

      &:hover {
        color: var(--rs26-blue-bright);
        text-decoration: underline;
      }
    }
  }
</style>
