---
import Layout from "../../layouts/Layout.astro";
---

<Layout>
  <h2>Attributions</h2>
  <div class="attributions">
    <section>
      <h3>Open Source Libraries</h3>
      <ul>
        <li><a href="https://astro.build">Astro</a> - Web framework</li>
        <li>
          <a href="https://www.splidejs.com">Splide.js</a> - Carousel component
        </li>
      </ul>
    </section>

    <section>
      <h3>Design Assets</h3>
      <ul>
        <li>
          <a href="https://sessionize.com/brand">Sessionize Icon</a> by Sessionize
        </li>
      </ul>
    </section>

    <section>
      <h3>Special Thanks</h3>
      <p>
        We would like to thank all the contributors, speakers, sponsors, and
        volunteers who make Reversim Summit possible. Your dedication to the
        developer community is what makes this event special.
      </p>
    </section>

    <style lang="scss">
      .attributions {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
        color: var(--rs26-text);

        section {
          margin-bottom: 40px;
        }

        h3 {
          color: var(--rs26-blue-bright);
          margin-bottom: 16px;
        }

        ul {
          list-style: none;
          padding: 0;

          li {
            margin-bottom: 8px;

            a {
              color: var(--rs26-mint);
              text-decoration: none;

              &:hover {
                color: var(--rs26-orange);
                text-decoration: underline;
              }
            }
          }
        }

        p {
          line-height: 1.6;
        }
      }
    </style>
  </div></Layout
>
