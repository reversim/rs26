---
import Layout from "../layouts/Layout.astro";
---

<Layout class:list={["container"]}>
  <div class="not-found">
    <p class="eyebrow">404 · node not found</p>
    <h1>404</h1>
    <p class="lede">This route drifted off the mesh.</p>
    <a href="/">Back to home →</a>
  </div>
</Layout>

<style lang="scss">
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 80px 0;
    text-align: center;
  }

  h1 {
    font-size: 90px;
    margin: 0;
    color: var(--white);
  }

  .lede {
    color: var(--text-lede);
    margin: 0;
  }

  a {
    margin-top: 12px;
    color: var(--orange);
    font-family: var(--font-mono);
    font-weight: 500;
  }
</style>

<script>
  const url = window.location.pathname;
  if (url.startsWith("/agenda/")) {
    window.location.href = "/agenda";
  }
</script>
