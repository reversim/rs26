---
import "@splidejs/splide/css";
import type { GetStaticPaths } from "astro";
import { getImage, Image, Picture } from "astro:assets";
import PhotoCarousel from "../../components/photoCarousel.astro";
import SocialLinks from "../../components/socialLinks.astro";
import { getSponsors } from "../../helpers/data/getSponsors";
import Layout from "../../layouts/Layout.astro";

export const getStaticPaths = (async () => {
  const sponsors = await getSponsors();

  return sponsors
    .map((sponsor) => ({
      params: {
        sponsor: sponsor.slug,
      },
      props: { ...sponsor },
    }))
    .filter((sponsor) => sponsor.props.sponsorTier !== "community");
}) satisfies GetStaticPaths;

const {
  companyName,
  description,
  website,
  companyNameLogo,
  carouselImages,
  technologyStack,
  openPositions,
  testimonials,
  linkedin,
  twitter,
  bluesky,
  facebook,
  github,
  instagram,
  medium,
  youtube,
  slug,
} = Astro.props;

const haveOpenPositions = openPositions.length > 0;

const socialList = {
  website,
  linkedin,
  twitter,
  bluesky,
  facebook,
  github,
  instagram,
  medium,
  youtube,
};

const websiteLabel = website?.replace(/^https?:\/\//, "").replace(/\/$/, "");

const carouselImagesPromise = await Promise.all(
  carouselImages.map(async (image) => {
    return await getImage({ src: image, width: 1000, height: 600 });
  }),
);

const initials = (name: string) =>
  (name || "")
    .trim()
    .split(/\s+/)
    .map((word) => word[0])
    .slice(0, 2)
    .join("")
    .toUpperCase();
---

<Layout havePadding={false}>
  <div class="wrap">
    <a class="back" href="/#sponsors">← Back to sponsors</a>
  </div>

  <section class="sp-masthead">
    <div class="wrap">
      <div class="sp-head">
        <div class="sp-logo">
          <Image
            class={`company-logo ${slug}`}
            src={companyNameLogo}
            alt={companyName}
            height={500}
            width={500}
          />
        </div>
        <div>
          <h1>{companyName}</h1>
          {
            website && (
              <a class="sp-web" href={website} target="_blank" rel="noopener">
                ↗ {websiteLabel}
              </a>
            )
          }
          <SocialLinks socialList={socialList || {}} />
        </div>
      </div>
    </div>
  </section>

  <section class="block band">
    <div class="wrap">
      <div class="sp-grid">
        <div class="sp-about">
          <p class="lab">Who we are</p>
          <p class="sponsor-description">{description}</p>
        </div>
        {
          technologyStack.length > 0 && (
            <div>
              <p class="lab">Tech stack</p>
              <div class="stack">
                {technologyStack.map((tech) => (
                  <span class="chip">{tech}</span>
                ))}
              </div>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    carouselImagesPromise.length > 0 && (
      <section class="block">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">Inside {companyName}</p>
              <h2>Life at the company</h2>
            </div>
          </div>
          <PhotoCarousel
            slides={carouselImagesPromise.map((image, index) => ({
              src: image.src,
              alt: `${companyName} image ${index + 1}`,
            }))}
            ariaLabel={`${companyName} photos`}
            mobileAspectRatio="4/3"
            mobileBorderRadius="var(--rs26-r-lg)"
          />
        </div>
      </section>
    )
  }

  {
    haveOpenPositions && (
      <section class="block band">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">They're hiring</p>
              <h2>Open positions</h2>
            </div>
          </div>
          <div class="pos-list">
            {openPositions.map((position) => (
              <a
                target="_blank"
                rel="noopener"
                href={position.positionLink}
                class="pos"
              >
                <div>
                  <div class="pt">{position.position}</div>
                  <div class="pl">{position.location}</div>
                </div>
                <span class="parrow">↗</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    testimonials.length > 0 && (
      <section class="block">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">In their words</p>
              <h2>Life on the team</h2>
            </div>
          </div>
          <div class="tst-grid">
            {testimonials.map((testimonial) => (
              <figure class="tst">
                <blockquote class="quote">
                  {(testimonial.testimonialDescription || "").trim()}
                </blockquote>
                <figcaption class="by">
                  <span class="av">
                    {testimonial.image ? (
                      <Picture
                        formats={["avif", "webp"]}
                        src={testimonial.image}
                        alt={testimonial.testimonialAuthor}
                        width={88}
                        height={88}
                      />
                    ) : (
                      initials(testimonial.testimonialAuthor)
                    )}
                  </span>
                  <span>
                    <span class="an">{testimonial.testimonialAuthor}</span>
                    {testimonial.position && (
                      <span class="at">{testimonial.position}</span>
                    )}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Layout>

<style lang="scss">
  @use "../../styles/breakpoints" as *;

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--rs26-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--rs26-muted);
    padding: 22px 0 0;

    &:hover {
      color: var(--rs26-orange);
    }
  }

  .sp-head {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(22px, 4vw, 44px);
    align-items: center;
    padding: clamp(26px, 4vw, 44px) 0 clamp(30px, 4vw, 48px);

    @media (max-width: $breakpoint-medium) {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
      gap: 20px;
      padding-bottom: clamp(24px, 6vw, 40px);
    }

    h1 {
      font-size: clamp(2.4rem, 6vw, 4.2rem);
      color: var(--rs26-white);
      line-height: 0.94;

      @media (max-width: $breakpoint-medium) {
        font-size: clamp(2rem, 9vw, 2.8rem);
      }
    }
  }

  // Dark panel card; logos knock out to white (Teads keeps its colors).
  .sp-logo {
    width: clamp(140px, 22vw, 220px);
    height: clamp(96px, 15vw, 150px);
    border-radius: var(--rs26-r-lg);
    background: var(--rs26-panel-2);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px;
    border: 1px solid var(--rs26-navy-line);
    box-shadow: 0 30px 60px -34px rgba(0, 0, 0, 0.8);

    .company-logo {
      max-width: 100%;
      max-height: 100%;
      width: auto;
      height: auto;
      object-fit: contain;
      filter: brightness(0) invert(1);

      &.teads {
        filter: brightness(1) invert(0);
      }
    }

    @media (max-width: $breakpoint-medium) {
      width: 132px;
      height: 96px;
      padding: 16px;
      border-radius: var(--rs26-r-md);
    }
  }

  .sp-web {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    margin-bottom: 20px;
    font-family: var(--rs26-mono);
    font-size: 0.9rem;
    color: var(--rs26-blue-bright);

    &:hover {
      color: var(--rs26-orange);
    }

    @media (max-width: $breakpoint-medium) {
      margin-top: 12px;
    }
  }

  .sp-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(30px, 5vw, 64px);
    align-items: start;

    @media (max-width: $breakpoint-medium) {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }

  .lab {
    font-family: var(--rs26-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--rs26-mint);
    margin: 0 0 16px;
  }

  .sponsor-description {
    white-space: pre-wrap;
    font-size: 1.12rem;
    line-height: 1.6;
    color: #c9d3ee;
    margin: 0;
    max-width: 60ch;

    @media (max-width: $breakpoint-medium) {
      font-size: 1.02rem;
    }
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;

    .chip {
      display: inline-flex;
      align-items: center;
      font-family: var(--rs26-mono);
      font-size: 0.78rem;
      letter-spacing: 0.04em;
      padding: 0.5em 0.85em;
      border-radius: 999px;
      white-space: nowrap;
      border: 1px solid var(--rs26-navy-line);
      background: rgba(108, 140, 199, 0.08);
      color: #cdd8f3;
    }
  }

  .pos-list {
    display: grid;
    gap: 10px;
  }

  .pos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 18px 22px;
    border-radius: var(--rs26-r-md);
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
    transition:
      transform 0.2s var(--rs26-ease),
      border-color 0.2s var(--rs26-ease),
      box-shadow 0.25s var(--rs26-ease);

    &:hover {
      transform: translateY(-2px);
      border-color: var(--rs26-blue);
      box-shadow: 0 20px 40px -28px rgba(0, 0, 0, 0.9);
      color: inherit;
    }

    // The rule above out-specifies the global hover-kill in _base.scss.
    @media (hover: none) {
      &:hover {
        transform: none;
      }
    }

    @media (max-width: $breakpoint-medium) {
      padding: 16px 18px;
      gap: 12px;
      min-height: 64px;
    }

    .pt {
      font-family: var(--rs26-display);
      font-size: 1.05rem;
      font-weight: 600;
      color: var(--rs26-white);

      @media (max-width: $breakpoint-medium) {
        font-size: 0.98rem;
      }
    }

    .pl {
      font-family: var(--rs26-mono);
      font-size: 0.72rem;
      color: var(--rs26-muted);
      margin-top: 4px;
      letter-spacing: 0.03em;
    }

    .parrow {
      color: var(--rs26-orange);
      font-size: 1.2rem;
      flex: 0 0 auto;
    }
  }

  .tst-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
    align-items: start;

    @media (max-width: $breakpoint-medium) {
      grid-template-columns: 1fr;
    }
  }

  .tst {
    display: flex;
    flex-direction: column;
    padding: 26px 26px 24px;
    border-radius: var(--rs26-r-lg);
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
    margin: 0;

    @media (max-width: $breakpoint-medium) {
      padding: 22px;
    }

    .quote {
      font-size: 1.02rem;
      line-height: 1.55;
      color: #c9d3ee;
      margin: 0 0 20px;
      text-wrap: pretty;
      white-space: pre-wrap;

      &::before {
        content: "\201C";
        display: block;
        font-family: var(--rs26-display);
        font-size: 2.6rem;
        line-height: 0.4;
        color: var(--rs26-orange);
        margin-bottom: 10px;
      }
    }

    .by {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: auto;
    }

    .av {
      width: 44px;
      height: 44px;
      flex: 0 0 auto;
      border-radius: 50%;
      overflow: hidden;
      background: rgba(240, 122, 35, 0.16);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--rs26-display);
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--rs26-orange);
      border: 1px solid var(--rs26-navy-line);

      :global(img) {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    .an {
      display: block;
      font-family: var(--rs26-display);
      font-weight: 600;
      color: var(--rs26-white);
      font-size: 0.98rem;
    }

    .at {
      display: block;
      font-family: var(--rs26-mono);
      font-size: 0.72rem;
      color: var(--rs26-muted);
      margin-top: 3px;
      letter-spacing: 0.02em;
    }
  }
</style>
