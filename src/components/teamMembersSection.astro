---
import { getTeamMembers } from "../helpers/data/getTeam";
import MemberGrid from "./memberGrid.astro";

const teamMembers = await getTeamMembers();
---

<section class="block" id="team">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">The people behind it</p>
        <h2>Our team</h2>
      </div>
    </div>
    <MemberGrid members={teamMembers} />
  </div>
</section>
