---
import { Image } from "astro:assets";
import { event } from "../config/event";
import { sponsorTiers } from "../config/sponsorTiers";
import { getSponsors } from "../helpers/data/getSponsors";
import Button from "./button.astro";
import SponsorDialog from "./sponsorDialog.astro";

const organizingSponsor = await getSponsors("organizing");
const communitySponsors = await getSponsors("community");
const gameChangersSponsors = await getSponsors("game-changers");

const tierLabel = (key: string) =>
  sponsorTiers.find((tier) => tier.key === key)?.label ?? "";

// Mono tier-marker glyphs from the design reference.
const tierMark: Record<string, string> = {
  organizing: "◆",
  "game-changers": "●",
  community: "○",
};
---

<script is:inline>
  // Dialog functionality for community sponsors
  document.addEventListener("DOMContentLoaded", () => {
    // Add click handlers for clickable sponsor images
    document.querySelectorAll(".clickable-sponsor").forEach((sponsorImg) => {
      sponsorImg.addEventListener("click", (e) => {
        e.preventDefault();
        const sponsorSlug = e.target.closest(".sponsor-item").dataset.sponsor;
        const dialog = document.getElementById(`sponsor-dialog-${sponsorSlug}`);
        if (dialog) {
          dialog.showModal();
        }
      });
    });

    // Add click handlers for close dialog buttons
    document.querySelectorAll(".close-dialog").forEach((closeBtn) => {
      closeBtn.addEventListener("click", (e) => {
        const sponsorSlug = e.target.closest(".close-dialog").dataset.sponsor;
        const dialog = document.getElementById(`sponsor-dialog-${sponsorSlug}`);
        if (dialog) {
          dialog.close();
        }
      });
    });

    // Close dialog when clicking outside the content
    document.querySelectorAll(".sponsor-dialog").forEach((dialog) => {
      dialog.addEventListener("click", (e) => {
        if (e.target === dialog) {
          dialog.close();
        }
      });
    });
  });
</script>

<section class="block band" id="sponsors">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Powered by</p>
        <h2>Our sponsors</h2>
      </div>
      <Button
        variant="orange"
        text={event.sponsor.label}
        href={event.sponsor.url}
      />
    </div>

    {
      organizingSponsor.length > 0 && (
        <>
          <p class="tier">
            {tierMark["organizing"]} {tierLabel("organizing")}
          </p>
          <div class="spon-grid organizing">
            {organizingSponsor.map((sponsor) => (
              <a
                class="spon spon-lg"
                href={`/sponsors/${sponsor.slug}`}
                aria-label={sponsor.companyName}
              >
                <Image
                  class={`sponsor-logo ${sponsor.slug}`}
                  src={sponsor.companyNameLogo}
                  width={480}
                  height={240}
                  alt={`Sponsor ${sponsor.companyName}`}
                />
              </a>
            ))}
          </div>
        </>
      )
    }

    {
      gameChangersSponsors.length > 0 && (
        <>
          <p class="tier">
            {tierMark["game-changers"]} {tierLabel("game-changers")}
          </p>
          <div class="spon-grid">
            {gameChangersSponsors.map((sponsor) => (
              <a
                class="spon"
                href={`/sponsors/${sponsor.slug}`}
                aria-label={sponsor.companyName}
              >
                <Image
                  class={`sponsor-logo ${sponsor.slug}`}
                  src={sponsor.companyNameLogo}
                  width={400}
                  height={200}
                  alt={`Sponsor ${sponsor.companyName}`}
                />
              </a>
            ))}
          </div>
        </>
      )
    }

    {
      (communitySponsors?.length ?? 0) > 0 && (
        <>
          <p class="tier">
            {tierMark["community"]} {tierLabel("community")}
          </p>
          <div class="spon-grid community">
            {communitySponsors.map((sponsor) => (
              <div
                class="spon sponsor-item"
                data-sponsor={sponsor.slug}
                role="button"
                tabindex="0"
                aria-label={sponsor.companyName}
              >
                <Image
                  class={`sponsor-logo ${sponsor.slug} clickable-sponsor`}
                  src={sponsor.companyNameLogo}
                  width={300}
                  height={150}
                  alt={`Sponsor ${sponsor.companyName}`}
                />
              </div>
            ))}
          </div>
        </>
      )
    }
  </div>
</section>

<!-- Dialog elements for community sponsors -->
{communitySponsors?.map((sponsor) => <SponsorDialog sponsor={sponsor} />)}

<style lang="scss">
  @use "../styles/breakpoints" as *;

  .tier {
    font-family: var(--rs26-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.5;
    color: var(--rs26-muted);
    margin: 26px 0 12px;
  }

  .spon-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 14px;

    &.organizing {
      grid-template-columns: 1fr;
      max-width: 420px;
    }

    &.community {
      grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
      gap: 10px;
    }
  }

  .spon {
    height: 78px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--rs26-r-md);
    background: var(--rs26-panel-3);
    border: 1px solid var(--rs26-navy-line);
    cursor: pointer;
    transition:
      transform 0.2s var(--rs26-ease),
      border-color 0.2s var(--rs26-ease);

    &:hover {
      border-color: var(--rs26-orange);
      transform: translateY(-2px);
    }

    &.spon-lg {
      height: 130px;
    }
  }

  .community .spon {
    height: 54px;
  }

  .sponsor-logo {
    // Logos knock out to white on the dark cells…
    filter: brightness(0) invert(1);
    object-fit: contain;
    height: 40%;
    width: auto;
    max-width: 72%;

    // …except Teads (organizing sponsor keeps its real colors).
    &.teads {
      filter: brightness(1) invert(0);
    }
  }

  .spon-lg .sponsor-logo {
    height: 46%;
  }

  .community .sponsor-logo {
    height: 44%;
  }

  @media (max-width: $breakpoint-medium) {
    .spon-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 10px;

      &.organizing {
        grid-template-columns: 1fr;
        max-width: none;
      }

      &.community {
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
      }
    }

    .spon {
      height: 72px;

      &.spon-lg {
        height: 110px;
      }
    }

    .community .spon {
      height: 60px;
    }
  }

  // The scoped `.spon:hover` above out-specifies the global rule in _base.scss.
  @media (hover: none) {
    .spon:hover {
      transform: none;
    }
  }
</style>
