---
import HeaderLink from "./headerLink.astro";
import { getAgendaCurrentDay } from "../../helpers/data/getAgendaCurrentDay";
import { event } from "../../config/event";

const currentDayUrl = await getAgendaCurrentDay();

interface HeaderLink {
  link: string;
  label: string;
  iconColor: string;
  variant?: "button" | "link";
}

const navbarLinks: HeaderLink[] = [
  { link: "/", label: "Home", iconColor: "var(--blue)" },
  { link: currentDayUrl, label: "Agenda", iconColor: "var(--green)" },
  { link: "/about", label: "Team", iconColor: "var(--pink)" },
  { link: "/sponsors", label: "Sponsors", iconColor: "var(--orange)" },
];
---

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleButton: any = document.querySelector(".menu-toggle");
    const sidebar: any = document.querySelector(".sidebar-container");
    const blurOverlay: any = document.querySelector(".blur-overlay");
    const link: any = document.querySelectorAll(".header-link");

    toggleButton.addEventListener("click", (event: any) => {
      sidebar.classList.toggle("open");
      blurOverlay.classList.toggle("open");
      toggleButton.classList.toggle("open");
      event.stopPropagation(); // Prevent immediate closing when clicking the button
    });

    document.addEventListener("click", (event) => {
      if (
        !sidebar.contains(event.target) &&
        !toggleButton.contains(event.target)
      ) {
        sidebar.classList.remove("open");
        blurOverlay.classList.remove("open");
        toggleButton.classList.remove("open");
      }
    });

    link.forEach((link: any) => {
      link.addEventListener("click", (event: any) => {
        sidebar.classList.remove("open");
        blurOverlay.classList.remove("open");
        toggleButton.classList.remove("open");
      });
    });
  });
</script>

<div class="blur-overlay"></div>
<div>
  <div class="menu-toggle">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="sidebar-container">
    {
      navbarLinks.map((link) => (
        <HeaderLink
          link={link.link}
          label={link.label}
          iconColor={link.iconColor}
          variant={link?.variant}
        />
      ))
    }
    <span class="date-pill">{event.dates}</span>
  </div>
</div>

<div class="header">
  <div class="inner-container">
    <div class="navbar-container">
      {
        navbarLinks.map((link) => (
          <HeaderLink
            link={link.link}
            label={link.label}
            iconColor={link.iconColor}
            variant={link?.variant}
          />
        ))
      }
    </div>
    <span class="date-pill">{event.dates}</span>
  </div>
</div>

<style lang="scss">
  .header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 99999;
    height: var(--header-height);

    &:before {
      content: "";
      position: absolute;
      width: 100%;
      height: 100%;
      background-color: rgba(10, 22, 49, 0.6);
      backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--navy-line);
      animation: headerBackground;
      animation-timeline: --sponsorsReveal;

      @keyframes headerBackground {
        0%,
        65% {
          opacity: 0;
        }
        100% {
          opacity: 1;
        }
      }
    }
  }

  .date-pill {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
    padding: 0.45em 0.8em;
    border-radius: var(--radius-pill);
    background-color: rgba(108, 140, 199, 0.16);
    color: var(--blue-bright);

    @media screen and (max-width: 992px) {
      margin-top: auto;
    }
  }

  .inner-container {
    max-width: var(--max-container-width);
    margin: auto;
    padding: 8px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    top: 50%;
    transform: translateY(-50%);
  }

  .menu-toggle {
    display: none;
    @media screen and (max-width: 992px) {
      display: flex;
      position: fixed;
      top: 20px;
      right: 20px;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      z-index: 100000;
    }

    span {
      display: block;
      width: 30px;
      height: 4px;
      border-radius: 5px;
      background: var(--text-body);
      transition: 0.3s;
    }

    &.open span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
      opacity: 0;
    }

    &.open span:nth-child(2) {
      opacity: 0;
    }

    &.open span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
      opacity: 0;
    }
  }

  .navbar-container {
    display: flex;
    gap: 50px;

    @media screen and (max-width: 992px) {
      display: none;
    }
  }

  // Desktop bar date pill — on mobile it lives in the sidebar instead.
  .header .date-pill {
    @media screen and (max-width: 992px) {
      display: none;
    }
  }

  .sidebar-container {
    display: flex;
    flex-direction: column;
    align-items: start;
    background-color: var(--dark-blue);
    border-left: 1px solid var(--navy-line);
    position: fixed;
    right: -100%;
    top: 0px;
    bottom: 0px;
    width: 200px;
    height: 100%;
    padding: 36px 24px;
    gap: 42px;
    transition: right 0.3s ease-in-out;

    &.open {
      right: 0;
      z-index: 999999;
    }
  }

  .blur-overlay {
    transition: 1s;
    &.open {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 999999;
      background: #0303032b;
      backdrop-filter: blur(1px) saturate(100%);
    }
  }

  .rv-icon {
    width: 100px;
    height: auto;

    @media screen and (max-width: 1300px) {
      margin-left: 40px;
    }
    @media screen and (max-width: 1000px) {
      margin-left: 20px;
    }
  }
</style>
