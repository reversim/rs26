---
import { Image } from "astro:assets";
import logo from "../../assets/rs-25-logo.png";
import { event } from "../../config/event";
import { getAgendaCurrentDay } from "../../helpers/data/getAgendaCurrentDay";
import HeaderLink from "./headerLink.astro";

const currentDayUrl = await getAgendaCurrentDay();

interface HeaderLink {
  link: string;
  label: string;
  variant?: "button" | "link";
}

const navbarLinks: HeaderLink[] = [
  { link: "/", label: "Home" },
  { link: "/about", label: "Team" },
];
---

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleButton: any = document.querySelector(".menu-toggle");
    const sidebar: any = document.querySelector(".sidebar-container");
    const blurOverlay: any = document.querySelector(".blur-overlay");
    const link: any = document.querySelectorAll(".header-link");

    toggleButton.addEventListener("click", (event: any) => {
      sidebar.classList.toggle("open");
      blurOverlay.classList.toggle("open");
      toggleButton.classList.toggle("open");
      event.stopPropagation(); // Prevent immediate closing when clicking the button
    });

    document.addEventListener("click", (event) => {
      if (
        !sidebar.contains(event.target) &&
        !toggleButton.contains(event.target)
      ) {
        sidebar.classList.remove("open");
        blurOverlay.classList.remove("open");
        toggleButton.classList.remove("open");
      }
    });

    link.forEach((link: any) => {
      link.addEventListener("click", () => {
        sidebar.classList.remove("open");
        blurOverlay.classList.remove("open");
        toggleButton.classList.remove("open");
      });
    });
  });
</script>

<div class="blur-overlay"></div>
<div>
  <div class="menu-toggle">
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="sidebar-container">
    {
      navbarLinks.map((link) => (
        <HeaderLink
          link={link.link}
          label={link.label}
          variant={link?.variant}
        />
      ))
    }
    <span class="head-date">{event.dates}</span>
  </div>
</div>

<div class="header">
  <div class="inner-container">
    <a class="logo-link" href="/" aria-label="Reversim home">
      <Image class="logo" src={logo} alt={event.name} height={100} />
    </a>
    <div class="navbar-container">
      {
        navbarLinks.map((link) => (
          <HeaderLink
            link={link.link}
            label={link.label}
            variant={link?.variant}
          />
        ))
      }
      <span class="head-date">{event.dates}</span>
    </div>
  </div>
</div>

<style lang="scss">
  .header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 99999;
    height: var(--header-height);
    background: rgba(10, 22, 49, 0.6);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--rs26-navy-line);
  }

  .inner-container {
    max-width: var(--rs26-maxw);
    margin: auto;
    padding: 8px clamp(18px, 4vw, 40px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    position: relative;
    top: 50%;
    transform: translateY(-50%);
  }

  .logo-link {
    display: flex;
    align-items: center;

    .logo {
      height: 34px;
      width: auto;
    }
  }

  .head-date {
    font-family: var(--rs26-mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    white-space: nowrap;
    text-transform: uppercase;
    padding: 0.45em 0.8em;
    border-radius: 999px;
    background: rgba(108, 140, 199, 0.16);
    color: var(--rs26-blue-bright);
  }

  .menu-toggle {
    display: none;
    @media screen and (max-width: 992px) {
      display: flex;
      position: fixed;
      top: 20px;
      right: 20px;
      flex-direction: column;
      gap: 5px;
      cursor: pointer;
      z-index: 100000;
    }

    span {
      display: block;
      width: 30px;
      height: 3px;
      border-radius: 5px;
      background: var(--rs26-white);
      transition: 0.3s;
    }

    &.open span:nth-child(1) {
      transform: translateY(8px) rotate(45deg);
      opacity: 0;
    }

    &.open span:nth-child(2) {
      opacity: 0;
    }

    &.open span:nth-child(3) {
      transform: translateY(-8px) rotate(-45deg);
      opacity: 0;
    }
  }

  .navbar-container {
    display: flex;
    align-items: center;
    gap: 6px;

    @media screen and (max-width: 992px) {
      display: none;
    }
  }

  .sidebar-container {
    display: flex;
    flex-direction: column;
    align-items: start;
    background: var(--rs26-navy-2);
    border-left: 1px solid var(--rs26-navy-line);
    position: fixed;
    right: -100%;
    top: 0px;
    bottom: 0px;
    width: 220px;
    height: 100%;
    padding: 72px 24px 36px;
    gap: 28px;
    transition: right 0.3s ease-in-out;

    &.open {
      right: 0;
      z-index: 999999;
    }
  }

  .blur-overlay {
    transition: 1s;
    &.open {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 999999;
      background: rgba(6, 15, 37, 0.5);
      backdrop-filter: blur(2px) saturate(100%);
    }
  }
</style>
