---
interface Props {
  label: string;
  link: string;
  variant?: "button" | "link";
}

const { label, link, variant } = Astro.props;
---

<a
  class={`header-link ${variant ?? ""}`}
  target={variant === "button" ? "_blank" : "_self"}
  href={link}
>
  {label}
</a>

<style lang="scss">
  .header-link {
    font-weight: 600;
    font-size: 0.94rem;
    padding: 0.5em 0.8em;
    border-radius: 999px;
    color: #dce4f7;
    opacity: 0.82;
    transition:
      opacity 0.2s,
      background 0.2s;

    &:hover {
      opacity: 1;
      color: var(--rs26-white);
    }

    &.button {
      border: 1px solid var(--rs26-navy-line);
      background: rgba(108, 140, 199, 0.12);
      opacity: 1;

      &:hover {
        border-color: var(--rs26-blue);
      }
    }
  }
</style>
