---
import Arrow from "../assets/agenda/arrow.svg";

interface Props {
  /** Visible label. For variant="back" it's rendered as "Back to {text}". */
  text: string;
  /** When set, renders an <a>; otherwise a <button>. */
  href?: string;
  /** Link target (only applied when href is set), e.g. "_blank". */
  target?: string;
  variant?: "back" | "orange" | "ghost";
  size?: "sm" | "md" | "lg";
  fullWidth?: boolean;
  id?: string;
  class?: string;
}

const {
  text,
  href,
  target,
  variant = "orange",
  size = "md",
  fullWidth = false,
  id,
  class: className = "",
} = Astro.props;

const isBack = variant === "back";
const classes = [
  "btn",
  variant,
  `size-${size}`,
  fullWidth ? "full-width" : "",
  className,
]
  .filter(Boolean)
  .join(" ");

const Tag = href ? "a" : "button";
---

<Tag
  class={classes}
  id={id}
  href={href}
  target={href ? target : undefined}
  rel={href && target === "_blank" ? "noopener" : undefined}
>
  {
    isBack ? (
      <>
        <Arrow class="back-arrow" /> Back to {text}
      </>
    ) : (
      text
    )
  }
</Tag>

<style lang="scss">
  .btn {
    font-family: inherit;
    cursor: pointer;
  }

  // ---- RS26 pill family (orange / ghost) -----------------------------------
  .btn.orange,
  .btn.ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    white-space: nowrap;
    font-family: var(--rs26-body);
    font-weight: 700;
    font-size: 0.98rem;
    padding: 0.85em 1.4em;
    border-radius: 999px;
    border: 0;
    transition:
      transform 0.18s var(--rs26-ease),
      box-shadow 0.25s var(--rs26-ease),
      background 0.2s,
      border-color 0.2s;

    &:active {
      transform: translateY(1px) scale(0.99);
    }

    &.full-width {
      width: 100%;
      justify-content: center;
    }
  }

  .btn.orange {
    background: var(--rs26-orange);
    color: var(--rs26-white);
    box-shadow: 0 8px 22px -8px rgba(240, 122, 35, 0.7);

    &:hover {
      color: var(--rs26-white);
      box-shadow: 0 14px 30px -10px rgba(240, 122, 35, 0.85);
      transform: translateY(-2px);
    }
  }

  .btn.ghost {
    background: transparent;
    color: var(--rs26-white);
    border: 1.5px solid var(--rs26-navy-line);

    &:hover {
      color: var(--rs26-white);
      border-color: var(--rs26-blue);
      background: rgba(108, 140, 199, 0.12);
    }
  }

  // ---- Touch foundations --------------------------------------------------
  // The global rules in _base.scss lose to these scoped selectors, so the
  // pill family carries its own copy. `.btn.back` is a text link, not a pill,
  // and is deliberately left out of the 48px floor.
  @media (hover: none) {
    .btn.orange:hover,
    .btn.ghost:hover {
      transform: none;
    }

    .btn.orange:active,
    .btn.ghost:active {
      transform: scale(0.97);
    }
  }

  @media (pointer: coarse) {
    .btn.orange,
    .btn.ghost {
      min-height: 48px;
      padding: 0.85em 1.5em;
    }
  }

  // ---- Back link ----------------------------------------------------------
  .btn.back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: max-content;
    height: max-content;
    margin-bottom: 12px;
    padding: 22px 0 0;
    font-family: var(--rs26-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--rs26-muted);
    background: none;
    border: none;
    transition: color 0.18s;

    &:hover {
      color: var(--rs26-orange);
    }

    .back-arrow {
      height: 13px;
      width: 13px;
      transform: scaleX(-1);
      fill: currentColor;
    }
  }
</style>
