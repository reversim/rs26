---
import "glightbox/dist/css/glightbox.css";
import { getPastEventsImages } from "../helpers/getPastEventsImages";
import Slider, { type ICarouselImage } from "./slider.astro";
import Title from "./title.astro";

const images: ICarouselImage[] = await getPastEventsImages();
---

<div class="past-events-container">
  <Title
    title="Past Events"
    style="color: black; margin: 100px 0 0"
    id="past-events"
  />
  <p class="past-events-description">
    Reversim Summit has run every year since 2013 in Israel, providing a
    community-driven space for learning and networking in software.
    <a
      href="https://summit.reversim.com/"
      target="_blank"
      class="past-events-link"
    >
      Explore our past events <span class="arrow">→</span>
    </a>
  </p>

  <Slider
    videos={[
      { url: "https://www.youtube.com/embed/gbcaCFO65Bo?si=_c-V6WTmXCb1ktut" },
    ]}
    images={images}
  />

  <style lang="scss">
    .past-events-description {
      margin-top: 20px;
      font-weight: 700;
      a {
        text-decoration: underline;
      }
    }

    .past-events-container {
      max-width: var(--breakpoint-x-large);
      margin: auto;
      position: relative;

      @media screen and (max-width: 576px) {
        padding: 20px 0% 0;
      }
    }
  </style>
</div>
