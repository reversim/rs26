---
import { getPastEventsImages } from "../helpers/data/getPastEventsImages";
import Button from "./button.astro";
import PhotoCarousel from "./photoCarousel.astro";
import type { CarouselImage } from "../types/slider";

const images: CarouselImage[] = await getPastEventsImages();
---

<section class="block band" id="past-events">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">The story so far</p>
        <h2>Past events</h2>
      </div>
      <Button
        variant="ghost"
        text="Explore past events →"
        href="https://summit.reversim.com/"
        target="_blank"
      />
    </div>
    <p class="past-lede">
      Reversim Summit has run every year since 2013 in Israel, providing a
      community-driven space for learning and networking in software.
    </p>

    <PhotoCarousel
      slides={images.map((image) => ({ src: image.src, alt: image.alt }))}
      ariaLabel="Photos from past summits"
      perPage={3}
      showThumbnails={false}
      interval={4500}
    />
  </div>
</section>

<style lang="scss">
  .past-lede {
    color: var(--rs26-text);
    max-width: 60ch;
    margin: 0 0 26px;
    font-size: clamp(1.05rem, 2vw, 1.32rem);
  }
</style>
