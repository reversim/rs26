---
import { getSpeakers } from "../helpers/data/getSpeakers";
import HeadingLink from "./headingLink.astro";
import MemberGrid from "./memberGrid.astro";
import FilterTabs from "./filterTabs.astro";
import type { TeamMember } from "../types/team";
import { event } from "../config/event";

const speakers = await getSpeakers();

const speakerCards: TeamMember[] = speakers.map((speaker) => ({
  id: speaker.id.toString(),
  slug: speaker.slug ?? "",
  name: speaker.fullName || "",
  title: speaker.tagLine || "",
  company: "",
  picture: speaker.profilePicture ?? "",
  bio: speaker.bio || "",
  day: speaker.day,
}));
---

<section class="block" id="speakers">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Who's speaking</p>
        <h2><HeadingLink href="/speakers">Our speakers</HeadingLink></h2>
      </div>
    </div>
    <FilterTabs
      id="speakers-day-filter-home"
      attr="day"
      targetSelector=".member"
      desktopOnly={true}
      sticky={true}
      options={event.days.options}
    />
    <MemberGrid
      members={speakerCards}
      pageBase="speaker"
      mobileLayout="swipe"
    />
  </div>
</section>
