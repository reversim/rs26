---
import type { AgendaDay } from "../../types/agenda";

interface Props {
  availableDays: AgendaDay[];
  currentDaySlug: string;
}

const { availableDays, currentDaySlug } = Astro.props;
---

<div class="day-switcher">
  {
    availableDays.map((day: AgendaDay) => (
      <a
        href={`/agenda/${day.slug}`}
        class={`day-switch-btn ${day.slug === currentDaySlug ? "active" : ""}`}
      >
        {day.label}
      </a>
    ))
  }
</div>

<style lang="scss">
  .day-switcher {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-bottom: 30px;
  }

  .day-switch-btn {
    background: var(--rs26-panel-2);
    border: 1px solid var(--rs26-navy-line);
    border-radius: 999px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s var(--rs26-ease);
    color: var(--rs26-muted);
    text-decoration: none;
    display: inline-block;

    &:hover {
      border-color: var(--rs26-blue);
      color: var(--rs26-white);
    }

    &.active {
      background: var(--rs26-orange);
      border-color: transparent;
      color: var(--rs26-white);

      &:hover {
        filter: brightness(1.06);
      }
    }
  }

  @media (max-width: 768px) {
    .day-switcher {
      flex-direction: column;
      gap: 8px;
    }
    .day-switch-btn {
      padding: 10px 20px;
      font-size: 13px;
    }
  }
</style>
