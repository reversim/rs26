---
import { formatTime } from "../../../helpers/agenda/agendaHelpers";

interface Props {
  highlighted: boolean;
  startsAt: string;
  endsAt: string;
}
const { startsAt, endsAt, highlighted } = Astro.props;
---

<div class=`time-column ${highlighted ? "highlighted" : ""}`>
  <div class="time-display">
    <div class="start-time">
      {formatTime(startsAt)}
    </div>
    <div class="end-time">
      {formatTime(endsAt)}
    </div>
  </div>
</div>

<style lang="scss">
  .time-column {
    grid-column: 1;
    width: 120px;
    min-width: 120px;
    background: var(--rs26-navy-2);
    border-right: 1px solid var(--rs26-navy-line);
    padding: 15px 10px;
    text-align: center;
    vertical-align: top;

    .time-display {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      font-family: var(--rs26-mono);

      .start-time {
        font-size: 15px;
        font-weight: 500;
        color: var(--rs26-blue-bright);
      }

      .end-time {
        font-size: 12px;
        font-weight: 400;
        color: var(--rs26-muted-3);
      }
    }

    &.highlighted {
      background: none;
      border: none;
    }
  }
</style>
