---
import DayHeader from "../dayHeader.astro";

interface Props {
  dayLabel: string;
  desiredRooms: string[];
}
const { dayLabel, desiredRooms } = Astro.props;
---

<DayHeader dayLabel={dayLabel} />
<div class="grid-header">
  <div class="time-column-header">Time</div>
  {
    desiredRooms.map((roomName) => (
      <div class="room-column-header">{roomName}</div>
    ))
  }
</div>

<style lang="scss">
  .grid-header {
    display: grid;
    grid-template-columns: 120px 1fr 1fr 1fr;
    background: var(--rs26-navy-2);
    border-bottom: 1px solid var(--rs26-navy-line);
    position: sticky;
    top: calc(var(--header-height) + 54px);
    z-index: 3;

    .time-column-header,
    .room-column-header {
      padding: 15px 20px;
      text-align: center;
      font-family: var(--rs26-mono);
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-size: 0.8rem;
      color: var(--rs26-blue-bright);
      border-right: 1px solid var(--rs26-navy-line);

      &:last-child {
        border-right: none;
      }
    }

    .time-column-header {
      width: 120px;
      min-width: 120px;
      background: var(--rs26-navy-3);
    }

    .room-column-header {
      width: 100%;
      min-width: 200px;
    }
  }
</style>
