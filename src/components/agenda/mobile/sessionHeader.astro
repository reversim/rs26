---
import { formatTime } from "../../../helpers/agenda/agendaHelpers";
import type { AgendaSession } from "../../../types/agenda";
import Category from "../category.astro";
import TalkActions from "../talkActions.astro";

interface Props {
  sessionStartsAt: string;
  duration: number;
  sessionRoom?: string;
  session: AgendaSession;
  isSession: boolean;
}
const { sessionRoom, sessionStartsAt, duration, session, isSession } =
  Astro.props;
---

<div class="session-header">
  <Category
    uppercase={false}
    categoryColor={"#6c8cc7"}
    track={sessionRoom}
  />
  <span class="time-duration">
    {formatTime(sessionStartsAt)}
    {" "}
    → {duration} min
  </span>
  {
    isSession ? (
      <TalkActions
        session={{ ...session, room: sessionRoom, startsAt: sessionStartsAt }}
      />
    ) : (
      <div />
    )
  }
</div>

<style lang="scss">
  .session-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 15px;

    .time-duration {
      font-family: var(--rs26-mono);
      font-size: 13px;
      color: var(--rs26-muted);
      font-weight: 500;
    }
  }
</style>
