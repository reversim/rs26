---
interface Props {
  track?: string | null;
  categoryColor: string;
  uppercase?: boolean;
  style?: string | null;
}
const { track, categoryColor, uppercase = true, style } = Astro.props;
---

{
  track && (
    <div
      class={`session-category ${uppercase ? "uppercase" : ""}`}
      style={`color: ${categoryColor}; background-color: color-mix(in srgb, ${categoryColor} 16%, transparent) ${style ? `; ${style}` : ""}`}
    >
      {track}
    </div>
  )
}

<style lang="scss">
  // Track chip: colored mono text on a translucent tint of the same color.
  .session-category {
    margin-top: 10px;
    display: inline-block;
    font-family: var(--rs26-mono);
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    width: max-content;

    &.uppercase {
      text-transform: uppercase;
    }
  }

  @media screen and (max-width: 767px) {
    .session-category {
      padding: 4px 12px;
      margin-top: 0;
    }
  }
</style>
