---
import type { TeamMember } from "../types/team";
import Button from "./button.astro";
import { Picture } from "astro:assets";
import SocialLinks from "./socialLinks.astro";

interface Props extends Partial<TeamMember> {
  socialList: Record<string, string | undefined>;
  type?: "about" | "speaker";
}

const {
  socialList,
  name,
  picture,
  title,
  company,
  bio,
  type = "about",
} = Astro.props;
---

<div class="member">
  <div class="dotbg" aria-hidden="true"></div>

  <Button
    variant="back"
    text={type === "about" ? "Team" : "Speakers"}
    href={type === "about" ? `/about` : `/speakers`}
  />

  <div class="m-grid">
    <div class="m-photo">
      {
        picture !== "" && (
          <Picture
            formats={["avif", "webp"]}
            src={picture || ""}
            alt={name || ""}
            width="500"
            height={"500"}
          />
        )
      }
    </div>
    <div class="m-info">
      <h1 class="m-name">{name}</h1>
      <p class="m-title">
        {title}{
          company && (
            <>
              {" "}
              · <b>{company}</b>
            </>
          )
        }
      </p>
      {bio && <p class="m-bio">{bio}</p>}
      <SocialLinks variant="member-large" socialList={socialList || {}} />
    </div>
  </div>
</div>

<style lang="scss">
  .member {
    position: relative;
  }

  .dotbg {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.5;
    pointer-events: none;
    background-image: radial-gradient(
      rgba(108, 140, 199, 0.16) 1.1px,
      transparent 1.1px
    );
    background-size: 30px 30px;
    -webkit-mask-image: radial-gradient(
      120% 90% at 30% 0%,
      #000 30%,
      transparent 78%
    );
    mask-image: radial-gradient(120% 90% at 30% 0%, #000 30%, transparent 78%);
  }

  .m-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: clamp(30px, 6vw, 72px);
    align-items: start;
    padding: clamp(30px, 5vw, 60px) 0 clamp(48px, 8vw, 96px);

    @media (max-width: 760px) {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }

  .m-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: var(--rs26-r-xl);
    overflow: hidden;
    border: 1px solid var(--rs26-navy-line);
    background: var(--rs26-panel-2);
    box-shadow: 0 40px 70px -40px rgba(0, 0, 0, 0.85);
    position: relative;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
    }

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
  }

  .m-role {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    margin-bottom: 14px;
    font-family: var(--rs26-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.4em 0.7em;
    border-radius: 999px;
    white-space: nowrap;
    color: var(--rs26-orange);
    background: rgba(240, 122, 35, 0.12);

    &::before {
      content: "";
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: currentColor;
    }
  }

  .m-name {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    color: var(--rs26-white);
    line-height: 0.92;
    letter-spacing: -0.03em;
  }

  .m-title {
    font-family: var(--rs26-display);
    font-size: clamp(1.15rem, 2.4vw, 1.6rem);
    font-weight: 500;
    color: var(--rs26-blue-bright);
    margin-top: 14px;

    b {
      color: var(--rs26-white);
      font-weight: 600;
    }
  }

  .m-bio {
    font-size: clamp(1.1rem, 2vw, 1.32rem);
    line-height: 1.55;
    color: #c9d3ee;
    max-width: 52ch;
    margin-top: 22px;
    text-wrap: pretty;
    white-space: pre-wrap;
  }

  .m-info :global(.social-links) {
    margin-top: 32px;
  }
</style>
