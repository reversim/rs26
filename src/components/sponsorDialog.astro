---
import { Picture } from "astro:assets";

export interface Props {
  sponsor: {
    slug: string;
    companyName: string;
    description: string;
    website?: string;
    companyNameLogo: any;
    openJobsLink?: string;
  };
}

const { sponsor } = Astro.props;
---

<dialog id={`sponsor-dialog-${sponsor.slug}`} class="sponsor-dialog">
  <div class="dialog-content">
    <div class="dialog-header">
      <Picture
        formats={["avif", "webp"]}
        class="dialog-logo"
        src={sponsor.companyNameLogo}
        width={300}
        height={500}
        alt={`${sponsor.companyName} logo`}
      />
      <button class="close-dialog" data-sponsor={sponsor.slug}>
        <svg
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M18 6L6 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path
            d="M6 6L18 18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    <div class="dialog-body">
      <h3>{sponsor.companyName}</h3>
      <p class="sponsor-description">{sponsor.description}</p>
      {
        sponsor.website && (
          <a
            href={sponsor.openJobsLink}
            target="_blank"
            rel="noopener noreferrer"
            class="sponsor-website"
          >
            JOB OPPORTUNITIES →
          </a>
        )
      }
    </div>
  </div>
</dialog>

<style lang="scss">
  .sponsor-dialog {
    border: none;
    border-radius: 12px;
    padding: 0;
    background: transparent;
    max-width: 500px;
    width: 90vw;
    backdrop-filter: blur(4px);

    &::backdrop {
      background-color: rgba(0, 0, 0, 0.5);
    }

    .dialog-content {
      background: var(--rs26-panel-2);
      border: 1px solid var(--rs26-navy-line);
      border-radius: var(--rs26-r-md);
      overflow: hidden;
      color: var(--rs26-white);
    }

    .dialog-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px 16px;
      background: rgba(108, 140, 199, 0.08);
      border-bottom: 1px solid var(--rs26-navy-line);

      .dialog-logo {
        filter: brightness(0) invert(1);
        height: 40px;
        width: auto;
        object-fit: contain;
      }

      .close-dialog {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        padding: 8px;
        border-radius: 6px;
        transition: background-color 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;

        &:hover {
          background-color: rgba(255, 255, 255, 0.1);
        }

        svg {
          width: 20px;
          height: 20px;
        }
      }
    }

    .dialog-body {
      padding: 24px;

      h3 {
        margin-bottom: 16px;
        font-size: 24px;
        font-weight: 700;
        color: white;
      }

      .sponsor-description {
        font-size: 16px;
        margin: 0 0 20px 0;
        color: var(--rs26-text);
        white-space: pre-wrap;
        line-height: 1.4;
      }

      .sponsor-website {
        display: inline-block;
        font-family: var(--rs26-mono);
        font-size: 0.82rem;
        letter-spacing: 0.04em;
        color: var(--rs26-orange);
        text-decoration: none;
        font-weight: 600;
        transition: color 0.2s ease;

        &:hover {
          color: var(--rs26-blue-bright);
        }
      }
    }
  }
</style>

