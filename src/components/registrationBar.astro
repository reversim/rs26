---
import { event } from "../config/event";
import {
  AnalyticsEvent,
  RegistrationSource,
  analyticsAttrs,
} from "../config/analytics";
---

{
  event.registration.display && (
    <div class="registration-bar" id="registrationBar" style="display: none;">
      <div class="registration-bar-main">
        <p class="registration-bar-text">{event.registration.announcement}</p>
        <a
          class="registration-bar-link"
          href={event.registration.url}
          {...analyticsAttrs(AnalyticsEvent.RegistrationClick, {
            registration_source: RegistrationSource.BannerLink,
            registration_href: event.registration.url,
          })}
        >
          {event.registration.label}
        </a>
      </div>
      {event.registration.notice && (
        <p class="registration-bar-notice">
          <span class="registration-bar-notice-icon" aria-hidden="true">
            !
          </span>
          <span class="registration-bar-notice-text">
            {event.registration.notice}
          </span>
        </p>
      )}
      <button
        class="registration-bar-close"
        id="registrationBarClose"
        type="button"
        aria-label="Dismiss registration announcement"
        {...analyticsAttrs(AnalyticsEvent.RegistrationBannerClose, {})}
      >
        <span aria-hidden="true">&times;</span>
      </button>
    </div>
  )
}

<script>
  const STORAGE_KEY = "rs26-registration-bar-dismissed";
  const bar = document.getElementById("registrationBar");
  if (bar) {
    if (localStorage.getItem(STORAGE_KEY) === "true") {
      bar.remove();
    } else {
      bar.style.display = "flex";
      document
        .getElementById("registrationBarClose")
        ?.addEventListener("click", () => {
          localStorage.setItem(STORAGE_KEY, "true");
          bar.remove();
        });
    }
  }
</script>

<style lang="scss">
  @use "../styles/breakpoints" as *;

  .registration-bar {
    --bar-gutter: clamp(18px, 4vw, 40px);
    --close-size: 26px;
    --close-space: calc(var(--bar-gutter) + var(--close-size) + 12px);

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 6px;
    // Symmetric inline padding keeps the text truly centered while
    // leaving room for the close button on the right.
    padding: 10px var(--close-space);
    background: var(--rs26-orange);
    color: var(--rs26-navy-3);
    text-align: center;
  }

  .registration-bar-main {
    display: flex;
    align-items: center;
    justify-content: center;
    column-gap: 18px;
    row-gap: 4px;
    flex-wrap: wrap;
  }

  .registration-bar-text {
    margin: 0;
    font-family: var(--rs26-body);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .registration-bar-notice {
    max-width: max-content;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-family: var(--rs26-body);
    font-weight: 600;
    font-size: 0.82rem;
    white-space: pre-wrap;
    line-height: 1.35;
    color: var(--rs26-white);
    background: rgba(6, 15, 37, 0.82);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    padding: 6px 14px;

    .registration-bar-notice-text {
      text-align: left;
      margin-left: 1em;
    }
  }

  .registration-bar-notice-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    line-height: 0;
    border-radius: 50%;
    background: var(--rs26-orange);
    color: var(--rs26-navy-3);
    font-size: 0.7rem;
    font-weight: 800;
  }

  .registration-bar-link {
    font-family: var(--rs26-body);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--rs26-navy-3);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;

    &:hover {
      color: var(--rs26-navy);
    }
  }

  .registration-bar-close {
    position: absolute;
    top: 50%;
    right: var(--bar-gutter);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--close-size);
    height: var(--close-size);
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(6, 15, 37, 0.12);
    color: var(--rs26-navy-3);
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition: background 0.18s;

    &:hover {
      background: rgba(6, 15, 37, 0.22);
    }
  }

  // The nav drawer is laid out assuming the header sits at the top of the
  // viewport; the bar would push the header (logo and X) down over the links.
  :global(body.nav-open) .registration-bar {
    display: none !important;
  }

  @media (max-width: $breakpoint-large) {
    .registration-bar {
      align-items: flex-start;
      padding: var(--bar-gutter);
      text-align: left;
    }

    .registration-bar-main {
      flex-direction: column;
      align-items: flex-start;
      row-gap: 8px;
      padding-right: var(--bar-gutter);
    }

    .registration-bar-notice {
      width: 100%;
      max-width: none;
      justify-content: flex-start;
      align-items: flex-start;
      border-radius: 14px;
      padding: 14px 16px;

      .registration-bar-notice-text {
        margin-left: 0;
      }
    }

    .registration-bar-notice-icon {
      width: 20px;
      height: 20px;
      font-size: 0.78rem;
      margin-top: 1px;
    }

    .registration-bar-close {
      top: 10px;
      transform: none;
    }
  }
</style>
