---
import { GA_MEASUREMENT_ID } from "../../config/analytics";

const gtagSrc = `https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`;
---

<!-- Google tag (gtag.js), run off the main thread by Partytown. -->
<script is:inline type="text/partytown" async src={gtagSrc}></script>
<script is:inline type="text/partytown" define:vars={{ GA_MEASUREMENT_ID }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function () {
    window.dataLayer.push(arguments);
  };
  window.gtag("js", new Date());
  window.gtag("config", GA_MEASUREMENT_ID);
</script>
