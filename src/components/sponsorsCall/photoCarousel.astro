---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Slide {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  slides: readonly Slide[];
  ariaLabel?: string;
}

const { slides, ariaLabel = "Photos" } = Astro.props;
const total = slides.length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<div
  class="photo-carousel"
  role="region"
  aria-roledescription="carousel"
  aria-label={ariaLabel}
>
  <div class="car-view">
    <div class="splide" aria-label={ariaLabel}>
      <div class="splide__track">
        <ul class="splide__list">
          {
            slides.map((slide, i) => (
              <li class="splide__slide car-slide" data-cap={slide.caption}>
                <Image
                  src={slide.src}
                  alt={slide.alt}
                  widths={[640, 1000, 1400]}
                  sizes="(max-width: 1240px) 100vw, 1240px"
                  loading={i < 2 ? "eager" : "lazy"}
                  draggable={false}
                />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <div class="car-shade" aria-hidden="true"></div>
    <span class="car-counter">{pad(1)} / {pad(total)}</span>
    <p class="car-cap">{slides[0].caption}</p>
    <button class="car-btn car-prev" type="button" aria-label="Previous photo"
      >‹</button
    >
    <button class="car-btn car-next" type="button" aria-label="Next photo"
      >›</button
    >
  </div>

  <div class="car-dots" role="tablist" aria-label="Slide navigation">
    {
      slides.map((_, i) => (
        <button
          class={`car-dot${i === 0 ? " on" : ""}`}
          aria-label={`Go to photo ${i + 1}`}
          data-i={i}
          type="button"
        />
      ))
    }
  </div>

  <div class="car-thumbs">
    {
      slides.map((slide, i) => (
        <button
          class={`car-thumb${i === 0 ? " on" : ""}`}
          aria-label={`Photo ${i + 1}`}
          data-i={i}
          type="button"
        >
          <Image
            src={slide.src}
            alt=""
            widths={[208]}
            sizes="104px"
            loading="lazy"
            draggable={false}
          />
        </button>
      ))
    }
  </div>
</div>

<script>
  import Splide from "@splidejs/splide";

  function initCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>(".photo-carousel");
    carousels.forEach((root) => {
      if (root.dataset.mounted === "true") return;
      root.dataset.mounted = "true";

      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const splideEl = root.querySelector<HTMLElement>(".splide");
      if (!splideEl) return;

      const slides = Array.from(
        root.querySelectorAll<HTMLElement>(".splide__slide"),
      );
      const total = slides.length;
      const dots = Array.from(
        root.querySelectorAll<HTMLElement>(".car-dot"),
      );
      const thumbsContainer =
        root.querySelector<HTMLElement>(".car-thumbs");
      const thumbs = Array.from(
        root.querySelectorAll<HTMLElement>(".car-thumb"),
      );
      const capEl = root.querySelector<HTMLElement>(".car-cap")!;
      const counterEl = root.querySelector<HTMLElement>(".car-counter")!;
      const pad = (n: number) => String(n).padStart(2, "0");

      const centerThumb = (thumb: HTMLElement | undefined) => {
        if (!thumb || !thumbsContainer) return;
        const cRect = thumbsContainer.getBoundingClientRect();
        const tRect = thumb.getBoundingClientRect();
        const offsetInContainer =
          tRect.left - cRect.left + thumbsContainer.scrollLeft;
        const target =
          offsetInContainer - cRect.width / 2 + tRect.width / 2;
        thumbsContainer.scrollTo({ left: target, behavior: "smooth" });
      };

      const splide = new Splide(splideEl, {
        type: "loop",
        perPage: 1,
        arrows: false,
        pagination: false,
        autoplay: !reduce,
        interval: 5000,
        pauseOnHover: true,
        pauseOnFocus: false,
        drag: true,
        keyboard: "focused",
        speed: 600,
        easing: "cubic-bezier(.22,.61,.36,1)",
      });

      const sync = (i: number) => {
        const slide = slides[i];
        capEl.textContent = slide?.getAttribute("data-cap") ?? "";
        counterEl.textContent = `${pad(i + 1)} / ${pad(total)}`;
        dots.forEach((d, j) => d.classList.toggle("on", j === i));
        thumbs.forEach((t, j) => t.classList.toggle("on", j === i));
        slides.forEach((s, j) =>
          s.setAttribute("aria-hidden", j === i ? "false" : "true"),
        );
        centerThumb(thumbs[i]);
      };

      splide.on("move", (newIndex: number) => sync(newIndex));
      splide.mount();
      sync(0);

      root
        .querySelector<HTMLElement>(".car-prev")
        ?.addEventListener("click", () => splide.go("<"));
      root
        .querySelector<HTMLElement>(".car-next")
        ?.addEventListener("click", () => splide.go(">"));

      root
        .querySelector<HTMLElement>(".car-dots")
        ?.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>(
            "[data-i]",
          );
          if (btn) splide.go(Number(btn.dataset.i));
        });

      root
        .querySelector<HTMLElement>(".car-thumbs")
        ?.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest<HTMLElement>(
            "[data-i]",
          );
          if (btn) splide.go(Number(btn.dataset.i));
        });

      const autoplay = splide.Components.Autoplay;
      document.addEventListener("visibilitychange", () => {
        if (reduce) return;
        if (document.hidden) autoplay?.pause();
        else autoplay?.play();
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCarousels);
  } else {
    initCarousels();
  }
</script>

<style lang="scss">
  .photo-carousel {
    outline: none;
  }

  .car-view {
    position: relative;
    border-radius: var(--rs26-r-xl);
    overflow: hidden;
    border: 1px solid var(--rs26-navy-line);
    background: var(--rs26-panel);
    box-shadow: 0 50px 90px -50px rgba(0, 0, 0, 0.9);
    aspect-ratio: 16 / 9;
    cursor: grab;

    &:active {
      cursor: grabbing;
    }
  }

  .car-view :global(.splide),
  .car-view :global(.splide__track),
  .car-view :global(.splide__list) {
    height: 100%;
  }

  .car-view :global(.splide__slide) {
    height: 100%;
    margin: 0;
    list-style: none;
  }

  .car-view :global(.splide__slide img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    display: block;
  }

  .car-shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
    background: linear-gradient(
      0deg,
      rgba(6, 15, 37, 0.85) 0%,
      rgba(6, 15, 37, 0.16) 30%,
      transparent 55%
    );
  }

  .car-cap {
    position: absolute;
    left: clamp(16px, 3vw, 30px);
    right: clamp(16px, 3vw, 30px);
    bottom: clamp(16px, 3vw, 26px);
    z-index: 3;
    font-family: var(--rs26-body);
    font-size: clamp(0.95rem, 1.6vw, 1.2rem);
    font-weight: 600;
    color: var(--rs26-white);
    max-width: 46ch;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.5);
    pointer-events: none;
    margin: 0;
  }

  .car-counter {
    position: absolute;
    top: 16px;
    left: 18px;
    z-index: 3;
    font-family: var(--rs26-mono);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    white-space: nowrap;
    color: var(--rs26-white);
    background: rgba(8, 18, 42, 0.6);
    border: 1px solid var(--rs26-navy-line);
    padding: 0.35em 0.7em;
    border-radius: 999px;
    backdrop-filter: blur(6px);
  }

  .car-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--rs26-navy-line);
    background: rgba(8, 18, 42, 0.7);
    color: var(--rs26-white);
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(8px);
    transition:
      background 0.18s,
      transform 0.18s,
      border-color 0.18s;
    font-family: inherit;
    padding: 0;

    &:hover {
      background: var(--rs26-orange);
      border-color: transparent;
      transform: translateY(-50%) scale(1.06);
    }
  }

  .car-prev {
    left: 14px;
  }

  .car-next {
    right: 14px;
  }

  .car-dots {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 18px;
  }

  .car-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 0;
    background: #2a3c66;
    cursor: pointer;
    padding: 0;
    transition: 0.2s;

    &.on {
      background: var(--rs26-orange);
      width: 26px;
      border-radius: 99px;
    }
  }

  .car-thumbs {
    display: flex;
    gap: 10px;
    margin-top: 18px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
    justify-content: center;
  }

  .car-thumb {
    flex: 0 0 auto;
    width: 104px;
    height: 62px;
    border-radius: 10px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer;
    padding: 0;
    background: none;
    opacity: 0.55;
    transition: 0.2s;

    :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    &.on {
      opacity: 1;
      border-color: var(--rs26-orange);
    }

    &:hover {
      opacity: 0.85;
    }
  }
</style>
