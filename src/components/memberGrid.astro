---
import MemberCard from "./memberCard.astro";
import type { TeamMember } from "../types/team";

interface Props {
  members: TeamMember[];
  // Route prefix for each card's link (e.g. "about" or "speaker").
  pageBase?: string;
}

const { members, pageBase = "about" } = Astro.props;
---

<div class="member-grid">
  {members.map((member) => <MemberCard {...member} pageBase={pageBase} />)}
</div>

<style lang="scss">
  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 18px;

    @media screen and (max-width: 576px) {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
</style>
