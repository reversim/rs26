---
import type { TeamMember } from "../types/team";
import { Picture } from "astro:assets";

interface Props extends TeamMember {
  pageBase?: string;
}

const { company, name, title, picture, slug, pageBase = "about" } = Astro.props;
---

<a data-astro-prefetch href={`/${pageBase}/${slug}`} class="member">
  <div class="photo">
    {
      picture !== "" && (
        <Picture
          formats={["avif", "webp"]}
          class="image"
          alt={name}
          src={picture}
          width="240"
          height="240"
        />
      )
    }
  </div>
  <h3 class="name">{name}</h3>
  <span class="role">{title}{" "}{company ? `@${company}` : ""}</span>
</a>

<style lang="scss">
  .member {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    transition:
      transform 0.2s var(--rs26-ease),
      color 0.2s;

    &:hover {
      transform: translateY(-3px);
      color: inherit;

      .photo {
        border-color: var(--rs26-blue);
      }
    }

    .photo {
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: var(--rs26-r-md);
      overflow: hidden;
      background: var(--rs26-panel-2);
      border: 1px solid var(--rs26-navy-line);
      transition: border-color 0.2s var(--rs26-ease);

      .image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }
    }

    .name {
      font-family: var(--rs26-display);
      font-weight: 600;
      font-size: 1.04rem;
      color: var(--rs26-white);
      margin-top: 2px;
    }

    .role {
      font-size: 0.84rem;
      color: #9fb0d6;
      line-height: 1.35;
    }
  }
</style>
