---
import Twitter from "../assets/socials/x-twitter.svg";
import Linkedin from "../assets/socials/linkedin.svg";
import Bluesky from "../assets/socials/bluesky.svg";
import Facebook from "../assets/socials/facebook.svg";
import Github from "../assets/socials/github.svg";
import Instagram from "../assets/socials/instagram.svg";
import Link from "../assets/socials/link.svg";
import Medium from "../assets/socials/medium.svg";
import Youtube from "../assets/socials/youtube.svg";
import Sessionize from "../assets/socials/sessionize.svg";

interface Props {
  link?: string;
  type: string;
  variant?: "sponsor" | "member-large" | "member-medium";
}

const iconMap: Record<string, { Icon: any; sizeBump?: number }> = {
  linkedin: { Icon: Linkedin },
  twitter: { Icon: Twitter },
  x: { Icon: Twitter },
  bluesky: { Icon: Bluesky },
  facebook: { Icon: Facebook },
  github: { Icon: Github },
  instagram: { Icon: Instagram },
  website: { Icon: Link, sizeBump: 4 },
  company_website: { Icon: Link, sizeBump: 4 },
  medium: { Icon: Medium },
  youtube: { Icon: Youtube },
  sessionize: { Icon: Sessionize },
};

const { link, type, variant } = Astro.props;
const baseSize = variant === "member-medium" ? 16 : 19;
const lowerCaseType = type.toLowerCase();

const entry = iconMap[lowerCaseType];
const Icon = entry?.Icon;
const iconWidth = baseSize + (entry?.sizeBump ?? 0);
---

{
  link && Icon && (
    <a class={`${variant} ${lowerCaseType}`} target="_blank" href={link}>
      <Icon width={iconWidth} />
    </a>
  )
}

<style lang="scss">
  a {
    border-radius: 50%;
    aspect-ratio: 1;
    width: 42px;

    display: flex;
    justify-content: center;
    align-items: center;

    border: 1px solid var(--rs26-navy-line);
    background: rgba(108, 140, 199, 0.08);
    transition:
      border-color 0.18s,
      background 0.18s,
      transform 0.18s;

    svg {
      fill: #cdd8f3;
      transition: fill 0.18s;
    }

    &:hover {
      border-color: var(--rs26-orange);
      background: rgba(240, 122, 35, 0.14);
      transform: translateY(-2px);

      svg {
        fill: var(--rs26-white);
      }
    }

    &.member-medium {
      width: 34px;
    }

    // Thumb-sized target on touch, without growing the desktop icon row.
    @media (pointer: coarse) {
      &:not(.member-medium) {
        width: 48px;
      }
    }
  }
</style>
