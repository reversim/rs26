---
import SocialLink from "./socialLink.astro";

type SocialEntry = { social: string; link: string };

interface Props {
  // Accepts either a { platform: url } record or a pre-shaped array.
  socialList: Record<string, string | undefined> | SocialEntry[];
  variant?: "sponsor" | "member-large" | "member-medium";
}
const { socialList, variant = "sponsor" } = Astro.props;

const entries: SocialEntry[] = Array.isArray(socialList)
  ? socialList
  : Object.entries(socialList).map(([social, link]) => ({
      social,
      link: link || "",
    }));
---

<div class={`social-links ${variant}`}>
  {
    entries.map(({ social, link }) => (
      <SocialLink variant={variant} type={social} link={link || ""} />
    ))
  }
</div>

<style lang="scss">
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 11px;

    margin-bottom: 24px;

    &.member-large {
      margin-top: 12px;
    }

    &.member-medium {
      justify-content: start;
      gap: 6px;
      margin-top: 12px;
    }
  }
</style>
