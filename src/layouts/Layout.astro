---
import Header from "../components/header/header.astro";
import RegistrationBar from "../components/registrationBar.astro";
import { Font } from "astro:assets";
import { getRedirectTarget } from "../config/redirects";
import GoogleAnalytics from "../components/shared/googleAnalytics.astro";
import { SITE_NAME, isRtl } from "../helpers/meta";
import "../styles/global.scss";

interface Props {
  havePadding?: boolean;
  havePaddingBottom?: boolean;
  displayHeader?: boolean;
  /** Document title; defaults to the generic site title. */
  title?: string;
  /** Link-preview title (og/twitter); defaults to `title`. */
  shareTitle?: string;
  /** Page and link-preview description; defaults to the generic site description. */
  description?: string;
}

const {
  havePadding = true,
  havePaddingBottom = false,
  displayHeader = true,
  title = "Reversim 2026",
  shareTitle = title,
  description = "Reversim Summit 2026 is Israel’s leading community-driven tech conference, bringing together developers, product managers, and data scientists for top-tier content and networking.",
} = Astro.props;

const redirectTarget = getRedirectTarget(Astro.url.pathname);
const isBlocked = redirectTarget !== undefined;
// Redirect stubs aren't real page views, and dev traffic stays out of GA.
const loadAnalytics = import.meta.env.PROD && !isBlocked;

// Every page identifies itself by its own URL so shares and likes are
// attributed to it, not to the homepage. Pages build as directories, so the
// canonical form ends with a slash.
const pageUrl = new URL(
  Astro.url.pathname.replace(/\/?$/, "/").replace(/^\/404\/$/, "/404.html"),
  Astro.site,
);
const ogLocale = isRtl(shareTitle) ? "he_IL" : "en_US";

// Must match the actual dimensions of public/og-image-2026.png.
const ogImage = new URL("/og-image-2026.png", Astro.site);
const ogImageWidth = 1200;
const ogImageHeight = 600;
const ogImageAlt =
  "Reversim Summit 2026 — Israel's community-driven software conference, Nov 30 – Dec 1, 2026";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark-mode.png" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-light-mode.png"
      media="(prefers-color-scheme: light)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-hanken-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!isBlocked && <link rel="canonical" href={pageUrl} />}

    {
      isBlocked && (
        <>
          <meta name="robots" content="noindex" />
          <meta http-equiv="refresh" content={`0;url=${redirectTarget}`} />
          <script is:inline define:vars={{ redirectTarget }}>
            window.location.replace(redirectTarget);
          </script>
        </>
      )
    }

    <meta property="og:title" content={shareTitle} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {loadAnalytics && <GoogleAnalytics />}
    <script>
      import { initAnalytics } from "../helpers/analytics";
      initAnalytics();
    </script>
  </head>
  <body>
    {!isBlocked && displayHeader && <RegistrationBar />}
    {!isBlocked && displayHeader && <Header />}
    {
      !isBlocked && (
        <div
          class={`body-container ${havePadding ? "have-padding" : ""} ${havePaddingBottom ? "have-padding-bottom" : ""}`}
        >
          <slot class="layout-container" />
        </div>
      )
    }
  </body>
</html>
