---
import Header from "../components/header/header.astro";
import { Font } from "astro:assets";
import "../styles/global.scss";

interface Props {
  havePadding?: boolean;
  havePaddingBottom?: boolean;
  displayHeader?: boolean;
}

const {
  havePadding = true,
  havePaddingBottom = false,
  displayHeader = true,
} = Astro.props;

const description =
  "Reversim Summit 2026 is Israel’s leading community-driven tech conference, bringing together developers, product managers, and data scientists for top-tier content and networking.";
const ogImage = new URL("/og-image.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon-dark-mode.png" />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-light-mode.png"
      media="(prefers-color-scheme: light)"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-space-grotesk" preload />
    <Font cssVariable="--font-hanken-grotesk" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta name="generator" content={Astro.generator} />
    <title>Reversim 2026</title>
    <meta name="description" content={description} />

    <meta property="og:title" content="Reversim 2026" />
    <meta property="og:site_name" content="Reversim Summit 2026" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Reversim Summit 2026, 30.11-1.12, 2026"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://summit2026.reversim.com/" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Reversim 2026" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google tag (gtag.js) -->
    <script
      type="text/partytown"
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-PSS53H641T"></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-PSS53H641T");
    </script>
  </head>
  <body>
    {displayHeader && <Header />}
    <div
      class={`body-container ${havePadding ? "have-padding" : ""} ${havePaddingBottom ? "have-padding-bottom" : ""}`}
    >
      <slot class="layout-container" />
    </div>
  </body>
</html>
